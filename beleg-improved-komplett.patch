+// Prüft, ob direkte Zitate wörtlich im analysierten Textabschnitt stehen.
+// Verglichen wird nur Buchstaben/Ziffern in Kleinschreibung. Dadurch spielen Silbentrennung am
+// Zeilenende, Zeilenumbrüche, Anführungszeichen und Interpunktion keine Rolle.
+
+const MIN_SEGMENT = 10; // kürzere Zitatteile sind zu unspezifisch für eine verlässliche Prüfung
+
+const compact = (s) =>
+  String(s || "").normalize("NFKC").toLowerCase().replace(/[^\p{L}\p{N}]+/gu, "");
+
+const QUOTE_MARKS = /[„“”"»«]/g;
+
+// Text zwischen dem ersten und letzten Anführungszeichen; ohne Anführungszeichen: alles vor dem Kurzbeleg.
+function extractQuote(zitat) {
+  const s = String(zitat || "");
+  const marks = [...s.matchAll(QUOTE_MARKS)].map((m) => m.index);
+  if (marks.length >= 2) return s.slice(marks[0] + 1, marks[marks.length - 1]);
+  return s.replace(/\([^()]*\)\s*\.?\s*$/, "");
+}
+
+// Auslassungen […] / ... / … und redaktionelle Einschübe [..] trennen das Zitat in prüfbare Teile.
+function segmentsOf(quote) {
+  return String(quote)
+    .split(/\[[^\]]*\]|…|\.{3}/)
+    .map(compact)
+    .filter((c) => c.length >= MIN_SEGMENT);
+}
+
+function pageBlocks(chunk) {
+  const parts = String(chunk).split(/\[Seite (\d+)\]/);
+  const blocks = [];
+  for (let i = 1; i < parts.length; i += 2) {
+    blocks.push({ page: Number(parts[i]), text: compact(parts[i + 1]) });
+  }
+  if (!blocks.length) blocks.push({ page: null, text: compact(chunk) });
+  return blocks;
+}
+
+function verifyEntries(entries, chunk) {
+  if (!Array.isArray(entries)) return entries;
+  const blocks = pageBlocks(chunk);
+  const full = blocks.map((b) => b.text).join("");
+
+  return entries.map((entry) => {
+    if (!entry || typeof entry !== "object") return entry;
+    const segs = segmentsOf(extractQuote(entry.direktes_zitat));
+    if (!segs.length) return { ...entry, zitat_status: "nicht_pruefbar", zitat_seite_pdf: null, seite_abweichend: false };
+
+    const found = segs.map((sg) => full.includes(sg));
+    const n = found.filter(Boolean).length;
+    const status = n === segs.length ? "ok" : n > 0 ? "teilweise" : "nicht_gefunden";
+
+    let seite = null;
+    if (n > 0) {
+      const first = segs[found.indexOf(true)];
+      const block = blocks.find((b) => b.text.includes(first));
+      seite = block ? block.page : null; // null, wenn das Zitat über eine Seitengrenze geht
+    }
+    const cited = String(entry.direktes_zitat || "").match(/S\.\s*(\d+)/);
+    const abweichend = seite != null && !!cited && Number(cited[1]) !== seite;
+
+    return { ...entry, zitat_status: status, zitat_seite_pdf: seite, seite_abweichend: abweichend };
+  });
+}
+
+module.exports = { verifyEntries, extractQuote, segmentsOf, compact };
