 };
-const MAX_PROMPT_CHARS = 200000;
+
+const MAX_TOKENS = 8000;
+const MAX_EXPO = 40000;
+const MAX_CHUNK = 40000;
+const MAX_ITEMS_JSON = 150000;
+const MAX_ATTEMPTS = 4;
+const DEADLINE_MS = 50000; // vercel.json: maxDuration 60 s
+const RETRYABLE = new Set([429, 500, 502, 503, 529]);
+
+class HttpError extends Error {
+  constructor(status, message) { super(message); this.status = status; }
+}
+
+function str(v, max, name, required = true) {
+  if (v === undefined || v === null || v === "") {
+    if (required) throw new HttpError(400, `${name} fehlt`);
+    return "";
+  }
+  if (typeof v !== "string") throw new HttpError(400, `${name} muss Text sein`);
+  if (v.length > max) throw new HttpError(413, `${name} ist zu groß (max. ${max} Zeichen).`);
+  return v;
+}
+
+const list = (v, maxItems, maxLen) =>
+  Array.isArray(v) ? v.slice(0, maxItems).map((x) => String(x).slice(0, maxLen)) : [];
+
+// Baut den Prompt aus validierten Rohdaten. Gibt auch den Chunk zurück (für die Zitatprüfung).
+function buildRequest(body) {
+  switch (body.kind) {
+    case "first": {
+      const expo = str(body.expo, MAX_EXPO, "expo");
+      const chunk = str(body.chunk, MAX_CHUNK, "chunk");
+      return { kind: "first", chunk, prompt: buildPromptFirst(expo, chunk, body.multiPart === true) };
+    }
+    case "next": {
+      const expo = str(body.expo, MAX_EXPO, "expo", false);
+      const chunk = str(body.chunk, MAX_CHUNK, "chunk");
+      const leitfrage = str(body.leitfrage, 2000, "leitfrage", false);
+      const autor = str(body.autor, 200, "autor", false);
+      const jahr = str(body.jahr, 50, "jahr", false);
+      const gliederung = list(body.gliederung, 60, 200);
+      return { kind: "next", chunk, prompt: buildPromptNext(expo, chunk, leitfrage, autor, jahr, gliederung) };
+    }
+    case "matrix": {
+      if (!Array.isArray(body.items) || !body.items.length) throw new HttpError(400, "items fehlt");
+      if (body.items.length > 300) throw new HttpError(413, "Zu viele Belege (max. 300).");
+      const items = body.items.map((it) => ({
+        id: Number(it && it.id) || 0,
+        kapitel: String((it && it.kapitel) || "").slice(0, 200),
+        argument: String((it && it.argument) || "").slice(0, 500),
+        relevanz: String((it && it.relevanz) || "").slice(0, 500),
+        kurz: String((it && it.kurz) || "").slice(0, 300),
+      }));
