+// Einfaches Rate-Limit pro IP und Zeitfenster.
+// Mit UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN wird ein gemeinsamer Zähler über alle
+// Serverless-Instanzen genutzt. Ohne Upstash gilt ein Zähler im Speicher der jeweiligen Instanz
+// (Best-Effort: bremst Missbrauch, ist aber kein harter Schutz).
+
+const mem = new Map();
+
+function clientIp(req) {
+  const xf = req.headers && (req.headers["x-forwarded-for"] || req.headers["x-real-ip"]);
+  if (xf) return String(xf).split(",")[0].trim();
+  return (req.socket && req.socket.remoteAddress) || "unknown";
+}
+
+async function checkRateLimit(req) {
+  const max = Number(process.env.RATE_LIMIT_MAX) || 150;
+  const windowS = Number(process.env.RATE_LIMIT_WINDOW_S) || 600;
+  const nowS = Date.now() / 1000;
+  const bucket = Math.floor(nowS / windowS);
+  const retryAfter = Math.max(1, Math.ceil(windowS - (nowS % windowS)));
+  const key = `zw:rl:${clientIp(req)}:${bucket}`;
+
+  let count;
+  const url = process.env.UPSTASH_REDIS_REST_URL;
+  const token = process.env.UPSTASH_REDIS_REST_TOKEN;
+  if (url && token) {
+    try {
+      const r = await fetch(`${url}/pipeline`, {
+        method: "POST",
+        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
+        body: JSON.stringify([["INCR", key], ["EXPIRE", key, windowS * 2]]),
+        signal: AbortSignal.timeout(2000),
+      });
+      const out = await r.json();
+      const n = Number(out && out[0] && out[0].result);
+      if (Number.isFinite(n)) count = n;
+    } catch (e) {
+      console.error("Rate-Limit via Upstash fehlgeschlagen, nutze Speicher:", e.message);
+    }
+  }
+
+  if (count === undefined) {
+    count = (mem.get(key) || 0) + 1;
+    mem.set(key, count);
+    if (mem.size > 5000) {
+      for (const k of mem.keys()) if (!k.endsWith(`:${bucket}`)) mem.delete(k);
+    }
+  }
+
+  return { ok: count <= max, limit: max, remaining: Math.max(0, max - count), retryAfter };
+}
+
+module.exports = { checkRateLimit, clientIp };
