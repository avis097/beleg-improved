+const crypto = require("node:crypto");
+const { buildPromptFirst, buildPromptNext, buildPromptMatrix } = require("./_prompts");
+const { verifyEntries } = require("./_verify");
+const { checkRateLimit } = require("./_ratelimit");
+
 const MODELS = {
   fast: process.env.ANTHROPIC_MODEL_FAST || "claude-haiku-4-5-20251001",
-  precise: process.env.ANTHROPIC_MODEL || "claude-sonnet-5",
