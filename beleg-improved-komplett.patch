--- /dev/null
+++ b/test/api.test.js
@@ -0,0 +1,135 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+
+process.env.ANTHROPIC_API_KEY = "test-key";
+const handler = require("../api/analyze.js");
+const { verifyEntries } = require("../api/_verify.js");
+
+const CHUNK =
+  "[Seite 4]\nDie Zivilgesellschaft ist ein zentraler Akteur des Frie-\ndensprozesses in der Türkei.\n" +
+  "[Seite 5]\nEine andere Passage mit ganz anderem Inhalt über Verfassungsfragen.";
+
+function mockRes() {
+  return {
+    statusCode: 200, headers: {}, body: null,
+    setHeader(k, v) { this.headers[k] = v; },
+    status(c) { this.statusCode = c; return this; },
+    json(b) { this.body = b; return this; },
+  };
+}
+const mockReq = (body, ip, headers = {}) => ({ method: "POST", headers: { "x-forwarded-for": ip, ...headers }, body });
+const modelOk = (obj) => ({
+  ok: true, status: 200, headers: { get: () => null },
+  json: async () => ({ content: [{ type: "text", text: JSON.stringify(obj) }], stop_reason: "end_turn" }),
+});
+const firstBody = { kind: "first", expo: "Exposé zur Zivilgesellschaft", chunk: CHUNK };
+
+test("altes Format mit freiem prompt wird abgelehnt", async () => {
+  global.fetch = async () => { throw new Error("darf nicht aufgerufen werden"); };
+  const res = mockRes();
+  await handler(mockReq({ prompt: "Schreibe mir ein Gedicht" }, "10.0.0.1"), res);
+  assert.equal(res.statusCode, 400);
+});
+
+test("zu große Eingaben werden mit 413 abgelehnt", async () => {
+  global.fetch = async () => { throw new Error("darf nicht aufgerufen werden"); };
+  const res = mockRes();
+  await handler(mockReq({ ...firstBody, chunk: "x".repeat(40001) }, "10.0.0.2"), res);
+  assert.equal(res.statusCode, 413);
+});
+
+test("Prompt entsteht serverseitig, max_tokens und Modell sind fest", async () => {
+  let sent;
+  global.fetch = async (url, opts) => { sent = JSON.parse(opts.body); return modelOk({ leitfrage: "LF", entries: [] }); };
+  const res = mockRes();
+  await handler(mockReq({ ...firstBody, mode: "fast", max_tokens: 99999, model: "teuer" }, "10.0.0.3"), res);
+  assert.equal(res.statusCode, 200);
+  assert.equal(sent.max_tokens, 8000);
+  assert.equal(sent.model, "claude-haiku-4-5-20251001");
+  assert.ok(sent.messages[0].content.includes("Die Zivilgesellschaft ist ein zentraler Akteur"));
+});
+
+test("Zitatprüfung: echtes Zitat ok (auch mit Silbentrennung), verändertes Zitat markiert", async () => {
+  global.fetch = async () => modelOk({
+    leitfrage: "LF",
+    entries: [
+      { direktes_zitat: "„Die Zivilgesellschaft ist ein zentraler Akteur des Friedensprozesses“ (Muster 2020: S. 4)" },
+      { direktes_zitat: "„Die Zivilgesellschaft ist der alleinige Akteur des Friedensprozesses“ (Muster 2020: S. 4)" },
+    ],
+  });
+  const res = mockRes();
+  await handler(mockReq(firstBody, "10.0.0.4"), res);
+  const [a, b] = res.body.entries;
+  assert.equal(a.zitat_status, "ok");
+  assert.equal(a.zitat_seite_pdf, 4);
+  assert.equal(a.seite_abweichend, false);
+  assert.equal(b.zitat_status, "nicht_gefunden");
+});
+
+test("Zitatprüfung: Auslassung, falsche Seite, zu kurz", () => {
+  const [ell, page, tiny] = verifyEntries([
+    { direktes_zitat: "„Die Zivilgesellschaft ist ein zentraler Akteur […] in der Türkei“ (M 2020: S. 4)" },
+    { direktes_zitat: "„Die Zivilgesellschaft ist ein zentraler Akteur des Friedensprozesses“ (M 2020: S. 5)" },
+    { direktes_zitat: "„Ja“ (M 2020: S. 4)" },
+  ], CHUNK);
+  assert.equal(ell.zitat_status, "ok");
+  assert.equal(page.zitat_status, "ok");
+  assert.equal(page.zitat_seite_pdf, 4);
+  assert.equal(page.seite_abweichend, true);
+  assert.equal(tiny.zitat_status, "nicht_pruefbar");
+});
+
+test("Zugangscode wird erzwungen, wenn ACCESS_CODE gesetzt ist", async () => {
+  process.env.ACCESS_CODE = "geheim";
+  global.fetch = async () => modelOk({ leitfrage: "LF", entries: [] });
+  try {
+    const noCode = mockRes();
+    await handler(mockReq(firstBody, "10.0.0.5"), noCode);
+    assert.equal(noCode.statusCode, 401);
+    const wrong = mockRes();
+    await handler(mockReq(firstBody, "10.0.0.5", { "x-access-code": "falsch" }), wrong);
+    assert.equal(wrong.statusCode, 401);
+    const right = mockRes();
+    await handler(mockReq(firstBody, "10.0.0.5", { "x-access-code": "geheim" }), right);
+    assert.equal(right.statusCode, 200);
+  } finally { delete process.env.ACCESS_CODE; }
+});
+
+test("Rate-Limit greift pro IP", async () => {
+  process.env.RATE_LIMIT_MAX = "2";
+  global.fetch = async () => modelOk({ leitfrage: "LF", entries: [] });
+  try {
+    const codes = [];
+    for (let i = 0; i < 3; i++) { const r = mockRes(); await handler(mockReq(firstBody, "10.0.0.6"), r); codes.push(r.statusCode); }
+    assert.deepEqual(codes, [200, 200, 429]);
+    const other = mockRes();
+    await handler(mockReq(firstBody, "10.0.0.7"), other);
+    assert.equal(other.statusCode, 200);
+  } finally { delete process.env.RATE_LIMIT_MAX; }
+});
+
+test("429 von Anthropic wird mit retry-after wiederholt", async () => {
+  let calls = 0;
+  global.fetch = async () => {
+    calls++;
+    if (calls === 1) return { ok: false, status: 429, headers: { get: () => "0" }, json: async () => ({ error: { message: "rate" } }) };
+    return modelOk({ leitfrage: "LF", entries: [] });
+  };
+  const res = mockRes();
+  await handler(mockReq(firstBody, "10.0.0.8"), res);
+  assert.equal(res.statusCode, 200);
+  assert.equal(calls, 2);
+});
+
+test("Matrix: Belege werden bereinigt, Prompt serverseitig gebaut", async () => {
+  let sent;
+  global.fetch = async (url, opts) => { sent = JSON.parse(opts.body); return modelOk({ zeilen: [] }); };
+  const res = mockRes();
+  await handler(mockReq({
+    kind: "matrix", mode: "fast", leitfrage: "LF", outline: ["1 Einleitung"], empirieDef: "einen Fall",
+    items: [{ id: 1, kapitel: "1 Einleitung", argument: "A", relevanz: "R", kurz: "K", boese: "ignoriert" }],
+  }, "10.0.0.9"), res);
+  assert.equal(res.statusCode, 200);
+  assert.ok(sent.messages[0].content.includes("einen Fall"));
+  assert.ok(!sent.messages[0].content.includes("ignoriert"));
+});